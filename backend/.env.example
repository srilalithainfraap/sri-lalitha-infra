# ── Server ──────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── MongoDB ─────────────────────────────────────────────
# Local:  mongodb://127.0.0.1:27017/srilalithainfra
# Atlas:  mongodb+srv://<user>:<pass>@cluster.mongodb.net/srilalithainfra
MONGODB_URI=mongodb://127.0.0.1:27017/srilalithainfra

# ── JWT ─────────────────────────────────────────────────
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_THIS_TO_A_RANDOM_64_BYTE_HEX_STRING
JWT_EXPIRES_IN=7d

# ── Admin Seed ──────────────────────────────────────────
# Used only when no admin exists in the database
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@srilalitha.com
ADMIN_MOBILE=9000000000
ADMIN_PASSWORD=CHANGE_THIS_STRONG_PASSWORD

# ── Cloudinary ──────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ── CORS ────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
FRONTEND_ORIGINS=http://localhost:5173,http://localhost:4173
